---
// Site-wide shell: meta tags, Google Analytics, header/footer, and LocalBusiness JSON-LD on every page.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { googleMapsProfileUrl, otherProfileUrls } from '../data/google-business';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = 'If Walls Could Talk | Brevard County Painting',
  description = 'Professional painting for Brevard County homeowners — interior, exterior, and more. Owner-operated with real standards since 2020.',
  ogImage = '/logotransparent.png',
  noindex = false,
} = Astro.props;

const siteOrigin = String(Astro.site ?? 'https://iwctpainting.com').replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImageURL = new URL(ogImage, siteOrigin);

const localBusinessSchema = {
  '@type': 'HousePainter',
  '@id': new URL('/#localbusiness', siteOrigin).href,
  name: 'If Walls Could Talk LLC',
  description:
    'Owner-operated painting company serving Brevard County, Florida with vetted local crews, clear standards, and transparent communication.',
  url: new URL('/', siteOrigin).href,
  image: new URL('/logotransparent.png', siteOrigin).href,
  telephone: '+1-321-557-6959',
  email: 'iwctpaintingplus@gmail.com',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Melbourne',
    addressRegion: 'FL',
    postalCode: '32901',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 28.0836,
    longitude: -80.6081,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '17:00',
    },
  ],
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Brevard County, Florida' },
    { '@type': 'Place', name: 'Space Coast, Florida' },
    { '@type': 'City', name: 'Melbourne, Florida' },
    { '@type': 'City', name: 'Palm Bay, Florida' },
    { '@type': 'City', name: 'Viera, Florida' },
    { '@type': 'City', name: 'Rockledge, Florida' },
    { '@type': 'City', name: 'Cocoa Beach, Florida' },
    { '@type': 'City', name: 'Satellite Beach, Florida' },
    { '@type': 'City', name: 'Merritt Island, Florida' },
    { '@type': 'City', name: 'Titusville, Florida' },
    { '@type': 'City', name: 'Cocoa, Florida' },
  ],
  knowsAbout: [
    'Interior Painting',
    'Exterior Painting',
    'Exterior Stucco Painting and Sealing',
    'Cabinet Painting and Refinishing',
    'Concrete Coatings',
    'Pool Deck Coatings',
    'Pressure Washing',
    'Color Consultation',
  ],
  sameAs: [googleMapsProfileUrl, ...otherProfileUrls],
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': new URL('/#website', siteOrigin).href,
  name: 'If Walls Could Talk',
  url: new URL('/', siteOrigin).href,
  description:
    'Painting services and honest homeowner education for Brevard County, Florida.',
  publisher: { '@id': new URL('/#localbusiness', siteOrigin).href },
  inLanguage: 'en-US',
};

// Single @graph so crawlers see the business and website as one connected entity.
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [localBusinessSchema, websiteSchema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) — exact snippet from GA; must stay global (no define:vars wrapper) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-37CLRJEDS9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-37CLRJEDS9');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logotransparent.png" />
    <link rel="apple-touch-icon" href="/logotransparent.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
