---
// Cabinet painting service page for Brevard County homeowners with process, tips, and FAQ.
import FaqSection from '../../components/FaqSection.astro';
import Layout from '../../layouts/Layout.astro';

const title = 'Cabinet Painting Brevard County | If Walls Could Talk';
const description =
  'Expert cabinet painting and wood refinishing in Brevard County. Smooth, durable finishes that stand up to Florida humidity and daily use.';

const whatWeCover = [
  'Kitchen upper and lower cabinets',
  'Bathroom vanity cabinets',
  'Laundry room cabinets',
  'Built-in shelving or storage units',
  'Kitchen islands',
];

const approachSteps = [
  {
    title: 'Remove doors and drawer fronts',
    details:
      'We take them off, number them, and paint both sides plus all edges for a clean finish.',
  },
  {
    title: 'Clean thoroughly',
    details:
      'Grease, residue, and buildup are completely removed so paint can bond correctly.',
  },
  {
    title: 'Degloss and sand',
    details:
      'The existing finish is dulled so primer can adhere properly and hold up over time.',
  },
  {
    title: 'Fill and repair',
    details:
      'Dings, scratches, and old hardware holes are filled and sanded smooth before primer and paint.',
  },
  {
    title: 'Prime',
    details:
      'We use the right primer for the material — wood, MDF — to improve adhesion and durability.',
  },
  {
    title: 'Paint',
    details:
      'Multiple thin coats of quality cabinet enamel, with light sanding between coats.',
  },
  {
    title: 'Reinstall',
    details:
      'Doors and drawers go back on with adjusted hinges for proper alignment.',
  },
];

const homeownerTips = [
  {
    title: "Don't skip deglossing and sanding",
    details:
      'Skipping this step is the main reason cabinet paint peels or chips early. The surface has to be properly prepared before primer goes on.',
  },
  {
    title: 'Use true cabinet enamel',
    details:
      'Standard wall paint stays too soft for cabinets. Hard-wearing cabinet enamel cures harder and holds up to daily use and humidity.',
  },
  {
    title: 'Light colors show more imperfections',
    details:
      'White and off-white finishes highlight every dent, seam, and texture issue. Prep quality matters even more with lighter colors.',
  },
  {
    title: 'Update hardware while doors are off',
    details:
      "With doors and drawer fronts already removed, it's a practical time to swap pulls or knobs if you've been thinking about it. Make sure you mention any changes before the project is started in case new hardware doesn't line up.",
  },
];

const faqs = [
  {
    question: 'How long does cabinet painting last in Florida?',
    answer:
      'With proper prep and quality enamel, 7–10 years is a reasonable expectation with normal use. Florida humidity makes good prep critical — skipping deglossing or priming is where most jobs fail early.',
  },
  {
    question: 'Is cabinet painting cheaper than replacing cabinets?',
    answer:
      "Yes. Painting your existing cabinets usually costs a fraction of what new ones do. You get a fresh look without tearing out the old cabinets or dealing with the mess and downtime of a full kitchen remodel.",
  },
  {
    question: 'What paint do you use on cabinets?',
    answer:
      'Hard-wearing water-based alkyd or urethane trim enamels. These cure much harder than standard wall paint and hold up better to daily use and Florida humidity.',
  },
  {
    question: 'Do cabinet doors need to be removed?',
    answer:
      'Yes. Removing doors and drawer fronts is the only way to properly paint all edges, avoid brush marks, and get a clean result.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout {title} {description}>
  <main class="page-container py-12 sm:py-16">
    <article class="mx-auto max-w-5xl space-y-12 text-base leading-relaxed text-charcoal sm:text-lg">
      <header class="space-y-5">
        <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Cabinet Painting in Brevard County
        </h1>
        <p>
          Cabinet painting is one of the most cost-effective ways to update a kitchen or bathroom without a full remodel.
          Thorough cleaning, deglossing, and the right hard-wearing enamel are what make it last through daily use and
          Florida humidity.
        </p>
      </header>

      <div class="watercolor-divider" aria-hidden="true"></div>

      <section aria-labelledby="what-we-cover-heading" class="space-y-5">
        <h2 id="what-we-cover-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What We Cover
        </h2>
        <p>
          We paint kitchen and bathroom cabinets, including doors, drawer fronts, frames, and boxes. We also handle:
        </p>
        <ul class="space-y-2">
          {whatWeCover.map((item) => (
            <li class="flex items-start gap-3 text-sm sm:text-base">
              <span class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-purple" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <div class="space-y-3">
          <h3 class="font-display text-lg font-semibold sm:text-xl">Hardware</h3>
          <p class="text-muted">
            We remove all pulls, knobs, and hinges before painting and reinstall them after.
          </p>
          <p class="text-muted">
            If you're thinking about changing the hardware, let us know ahead of time. That way we can make sure the new
            pieces line up cleanly.
          </p>
        </div>
      </section>

      <section aria-labelledby="approach-heading" class="space-y-5">
        <h2 id="approach-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          How We Approach It
        </h2>
        <p>
          Cabinet painting takes more prep steps than wall painting. That prep is what determines whether it lasts or
          starts chipping within a year.
        </p>
        <ol class="space-y-3">
          {approachSteps.map((step) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-4 sm:p-5">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{step.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{step.details}</p>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="expect-heading" class="space-y-5">
        <h2 id="expect-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What to Expect
        </h2>
        <p>
          A typical kitchen cabinet project takes 3–5 days. You'll still have access to the refrigerator, but the kitchen
          will otherwise be off limits during active work.
        </p>
        <p>
          The paint feels dry quickly, but full cure takes 2–4 weeks. Treat cabinets gently during that time — avoid
          slamming doors and use light cleaning only.
        </p>
        <p>
          Cabinet painting costs vary a lot depending on how many cabinets you have and the condition they're in.
        </p>
      </section>

      <section aria-labelledby="tips-heading" class="space-y-5">
        <h2 id="tips-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          Homeowner Tips
        </h2>
        <ul class="space-y-4">
          {homeownerTips.map((tip) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-5 sm:p-6">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{tip.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{tip.details}</p>
            </li>
          ))}
        </ul>
      </section>

      <FaqSection items={faqs} />
    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
