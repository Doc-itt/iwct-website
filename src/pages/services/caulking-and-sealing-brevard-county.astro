---
// Caulking and sealing service page for Brevard County homeowners with process, tips, and FAQ.
import FaqSection from '../../components/FaqSection.astro';
import Layout from '../../layouts/Layout.astro';

const title = 'Caulking and Sealing | If Walls Could Talk';
const description =
  'Caulking and sealing for homes in Brevard County. Practical information on exterior caulking before painting and proper sealing techniques.';

const whatWeCover = [
  'Exterior caulking before painting',
  'Sealing windows, doors, and trim',
  'Choosing the right caulk for different materials',
  'Sealing gaps in siding and stucco',
  'Proper application and tool techniques',
  'Maintenance and re-caulking',
];

const approachSteps = [
  {
    title: 'Inspect all exterior gaps',
    details:
      'We check windows, doors, trim, siding joints, and penetrations (lights, outlets, pipes) for gaps, cracks, or failing old caulk.',
  },
  {
    title: 'Remove old material',
    details:
      'Old, cracked, or shrinking caulk is fully removed so the new sealant can bond properly.',
  },
  {
    title: 'Clean the surfaces',
    details:
      'All areas must be clean and dry before applying new caulk. Dirt or moisture prevents good adhesion.',
  },
  {
    title: 'Choose the right product',
    details:
      'We use paintable, flexible exterior-grade caulk for areas that will be painted, and specialized sealants where maximum water resistance is needed.',
  },
  {
    title: 'Apply and tool',
    details:
      'We apply caulk in a continuous bead and tool it smoothly for a clean, professional finish that sheds water effectively.',
  },
];

const homeownerTips = [
  {
    title: 'Caulk before you paint',
    details:
      'Applying fresh caulk and letting it cure before painting gives the cleanest, most professional-looking results.',
  },
  {
    title: 'Not all caulk is the same',
    details:
      "Use flexible, exterior-grade, paintable caulk for most trim and siding joints. True silicone is great for wet areas but usually can't be painted over.",
  },
  {
    title: "Don't caulk everything",
    details:
      'Leave weep holes in windows and brick open for drainage. Over-sealing can trap moisture inside walls.',
  },
  {
    title: 'Re-caulk regularly',
    details:
      "In Florida's climate, caulk breaks down over time. Check and refresh exterior caulking every 2–3 years as part of normal home maintenance.",
  },
  {
    title: 'Good caulking prevents bigger problems',
    details:
      'Proper sealing around windows, doors, and penetrations is one of the cheapest ways to avoid water damage and mold issues later.',
  },
];

const faqs = [
  {
    question: 'Should caulking be done before or after painting?',
    answer:
      'Almost always before. Fresh caulk painted over looks seamless and lasts longer.',
  },
  {
    question: "What's the best caulk for Florida exteriors?",
    answer:
      'High-quality paintable acrylic latex or hybrid sealants that stay flexible in heat and humidity. We choose based on the specific location and material.',
  },
  {
    question: 'How often should exterior caulking be replaced?',
    answer:
      'Every 2–5 years depending on exposure. Homes near the coast or in full sun often need it more frequently.',
  },
  {
    question: 'Can I caulk over old caulk?',
    answer:
      'Usually not recommended. Old failing caulk should be removed first for the new sealant to adhere properly and last.',
  },
  {
    question: 'Do you seal the bottom of siding?',
    answer:
      'No. We leave the bottom of most siding (especially fiber cement or hardie) open for proper drainage and ventilation.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout {title} {description}>
  <main class="page-container py-12 sm:py-16">
    <article class="mx-auto max-w-5xl space-y-12 text-base leading-relaxed text-charcoal sm:text-lg">
      <header class="space-y-5">
        <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Caulking and Sealing
        </h1>
        <p>
          Caulking and sealing are critical steps that most homeowners don't think about until water starts getting in.
          In Brevard County's humid, rainy climate, properly sealed gaps around windows, doors, trim, and siding help
          prevent moisture intrusion, air leaks, and expensive damage.
        </p>
      </header>

      <div class="watercolor-divider" aria-hidden="true"></div>

      <section aria-labelledby="what-we-cover-heading" class="space-y-5">
        <h2 id="what-we-cover-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What We Cover
        </h2>
        <ul class="space-y-2">
          {whatWeCover.map((item) => (
            <li class="flex items-start gap-3 text-sm sm:text-base">
              <span class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-purple" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="approach-heading" class="space-y-5">
        <h2 id="approach-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          How We Approach It
        </h2>
        <ol class="space-y-3">
          {approachSteps.map((step) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-4 sm:p-5">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{step.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{step.details}</p>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="expect-heading" class="space-y-5">
        <h2 id="expect-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What to Expect
        </h2>
        <p>
          Caulking and sealing is usually done as part of a larger painting or maintenance project. It can take anywhere
          from a few hours to a couple of days depending on the size of the home and how much old material needs removal.
        </p>
        <p>
          The work is detailed and time-consuming, but it makes a big difference in how long the new paint job lasts.
        </p>
      </section>

      <section aria-labelledby="tips-heading" class="space-y-5">
        <h2 id="tips-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          Homeowner Tips
        </h2>
        <ul class="space-y-4">
          {homeownerTips.map((tip) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-5 sm:p-6">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{tip.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{tip.details}</p>
            </li>
          ))}
        </ul>
      </section>

      <FaqSection items={faqs} heading="Common Questions" />
    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
