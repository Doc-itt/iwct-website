---
// Exterior painting service page for Brevard County homeowners with process, tips, and FAQ.
import FaqSection from '../../components/FaqSection.astro';
import Layout from '../../layouts/Layout.astro';

const title = 'Exterior Painting Brevard County | If Walls Could Talk';
const description =
  'Durable exterior house painting in Brevard County designed for Florida heat, salt air, and storms. Thorough prep and long-lasting results by vetted crews.';

const whatWeCover = [
  'House siding, stucco, and block walls',
  'Soffits and fascia',
  'Trim and shutters',
  'Doors and garage doors',
  'Fences and gates',
  'Caulking around windows, doors, and trim',
  'Stucco crack repair before painting',
  'UV-protective and mildew-resistant coatings',
  'Rust-inhibiting primer for metal surfaces',
];

const approachSteps = [
  {
    title: 'Pressure wash',
    details:
      'Remove dirt, mildew, chalking, and any loose or flaking paint from the entire surface.',
  },
  {
    title: 'Inspect and repair',
    details:
      'Find and fix stucco cracks, damaged siding, rotted wood trim, or any spot where moisture could get behind the surface.',
  },
  {
    title: 'Caulk and seal',
    details:
      'Seal all gaps around windows, doors, trim, and penetrations with a flexible, paintable caulk rated for Florida temperature swings.',
  },
  {
    title: 'Prime',
    details:
      'Apply the right primer for the surface: moisture-blocking for bare stucco, rust-inhibiting for metal, bonding primer where needed.',
  },
  {
    title: 'Paint',
    details:
      'Apply quality coatings that flex with heat, resist UV fading, and let moisture escape without trapping it inside the wall.',
  },
];

const homeownerTips = [
  {
    title: "Don't paint over mildew",
    details:
      'Pressure washing removes surface dirt but not mildew roots. Treat with a mildewcide solution before washing, or mildew can bleed back through within months.',
  },
  {
    title: 'Check your caulk first',
    details:
      'Cracked or missing caulk around windows and doors is a leading cause of water damage in Florida homes. Walk the perimeter before you hire anyone and note what you find.',
  },
  {
    title: 'Avoid painting in direct afternoon sun in summer',
    details:
      'Surface temperatures can exceed 120°F, which prevents proper adhesion. Early morning or overcast days are better. Most paints need at least 24 hours before rain exposure.',
  },
  {
    title: 'Think about sheen before you decide',
    details:
      "Flat hides surface imperfections on stucco — useful on older walls where the surface isn't perfect. Satin and low-sheen finishes hold up better in humidity, clean more easily, and resist mildew better over time. Neither is wrong. It depends on your surface and goals.",
  },
  {
    title: 'Coastal homes need extra attention',
    details:
      "If you're within a mile of open water, ask about salt-tolerant coatings and rust-inhibiting primer on all metal surfaces — railings, shutters, exposed fasteners. Salt air accelerates corrosion more than most people expect.",
  },
];

const faqs = [
  {
    question: 'How long does exterior paint last in Brevard County?',
    answer:
      "With proper prep and quality paint, 7–10 years is a reasonable expectation. Skip prep and you're often looking at 3 years or less before peeling or fading starts.",
  },
  {
    question: 'What kind of paint works best on stucco in Florida?',
    answer:
      'A quality 100% acrylic or elastomeric is usually the right call. It bridges small cracks, flexes with temperature swings, and stays breathable so moisture can escape.',
  },
  {
    question: 'How do I know if my home needs exterior painting?',
    answer:
      "Chalking, cracking, peeling, faded or uneven color, water staining, and mildew growth are the main signs. Any one of those is worth looking at sooner rather than later in Florida's climate.",
  },
  {
    question: 'Does salt air actually affect paint?',
    answer:
      'Yes, more than most people realize. It accelerates corrosion and breaks down coatings faster. The closer you are to open water, the more it matters.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout {title} {description}>
  <main class="page-container py-12 sm:py-16">
    <article class="mx-auto max-w-5xl space-y-12 text-base leading-relaxed text-charcoal sm:text-lg">
      <header class="space-y-5">
        <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Exterior Painting in Brevard County
        </h1>
        <p>
          Exterior painting in Florida is more demanding than most people expect. The sun is intense, the humidity is
          constant, and if you're near the coast, salt air is working on your paint year-round.
        </p>
        <p>
          Florida's climate is hard on exterior coatings — heat, UV, and moisture put paint under stress that shows up faster here than in most of the country.
        </p>
      </header>

      <div class="watercolor-divider" aria-hidden="true"></div>

      <section aria-labelledby="what-we-cover-heading" class="space-y-5">
        <h2 id="what-we-cover-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What We Cover
        </h2>
        <p>
          Exterior painting is more than just walls. A complete exterior project can include all of these:
        </p>
        <ul class="space-y-2">
          {whatWeCover.map((item) => (
            <li class="flex items-start gap-3 text-sm sm:text-base">
              <span class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-purple" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="text-muted">
          We can handle the full exterior or focus on specific components, whatever the project needs.
        </p>
      </section>

      <section aria-labelledby="approach-heading" class="space-y-5">
        <h2 id="approach-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          How We Approach It
        </h2>
        <p>
          Most exterior failures in Florida trace back to a skipped step. Here's the sequence we follow:
        </p>
        <ol class="space-y-3">
          {approachSteps.map((step) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-4 sm:p-5">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{step.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{step.details}</p>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="expect-heading" class="space-y-5">
        <h2 id="expect-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What to Expect
        </h2>
        <p>
          Most single-story homes take 2–4 days for a full exterior. Two-story homes or jobs with heavy prep usually
          take longer. You get a clear timeline before work starts.
        </p>
        <p>
          We document every product used — colors, sheen levels, and application notes — so future touch-ups or repaints
          aren't guesswork.
        </p>
        <p>
          Pricing in Brevard County runs roughly $2.50–$6 per square foot of paintable surface. The lower end usually
          means less prep time, fewer coats, or lower-grade materials. In Florida's climate, that difference tends to
          show up within a few years.
        </p>
      </section>

      <section aria-labelledby="tips-heading" class="space-y-5">
        <h2 id="tips-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          Homeowner Tips
        </h2>
        <ul class="space-y-4">
          {homeownerTips.map((tip) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-5 sm:p-6">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{tip.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{tip.details}</p>
            </li>
          ))}
        </ul>
      </section>

      <FaqSection items={faqs} />
    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
