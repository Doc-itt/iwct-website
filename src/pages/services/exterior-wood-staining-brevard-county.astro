---
// Exterior wood staining service page for Brevard County homeowners with process, tips, and FAQ.
import FaqSection from '../../components/FaqSection.astro';
import Layout from '../../layouts/Layout.astro';

const title = 'Exterior Wood Staining | If Walls Could Talk';
const description =
  "Exterior wood staining in Brevard County. Practical information on staining decks, fences, pergolas, railings, and other exterior wood in Florida's climate.";

const whatWeCover = [
  'Cleaning and prep, including mildew treatment',
  'Minor wood repair and replacement',
  'Penetrating semi-transparent staining',
  'Solid stain options',
  'Decks, fences, pergolas, railings, shutters, and trim',
  'Whatever the project needs',
];

const approachSteps = [
  {
    title: 'Assess the wood',
    details:
      'We look at the current condition, how much old finish remains, signs of damage or mildew, and how much sun exposure the wood gets.',
  },
  {
    title: 'Clean and prep the surface',
    details:
      'Old failing finish, dirt, and mildew need to be removed so the new stain can penetrate and bond properly.',
  },
  {
    title: 'Repair as needed',
    details:
      "Damaged or soft wood gets fixed or replaced before staining. Stain won't fix structural problems.",
  },
  {
    title: 'Choose the right stain',
    details:
      "We focus on penetrating stains that perform well in Florida's UV and humidity. We also consider whether a semi-transparent or solid stain makes more sense based on the look and condition of the wood.",
  },
  {
    title: 'Apply under the right conditions',
    details:
      'Temperature and drying time affect how well the stain penetrates. We apply when conditions support good results.',
  },
];

const homeownerTips = [
  {
    title: 'Prep has the biggest impact on how long it lasts',
    details:
      'Thorough cleaning and removing old failing finish before staining makes more difference than the brand of stain you choose.',
  },
  {
    title: "Penetrating stains generally handle Florida's climate better than thick coatings",
    details:
      'They soak into the wood and move with it as it expands and contracts, which reduces peeling in high humidity.',
  },
  {
    title: 'New wood needs time before staining',
    details:
      'Fresh exterior wood should be properly prepared and allowed to dry before staining for best penetration and adhesion.',
  },
  {
    title: 'Mildew is common on exterior wood',
    details:
      "Black or green spots that keep returning usually mean the surface wasn't cleaned well enough or the stain lacks good mildewcide protection.",
  },
  {
    title: 'Semi-transparent vs solid stain is a trade-off',
    details:
      "Semi-transparent stains let more of the wood grain show and are generally easier to maintain over time. Solid stains give more color coverage and can hide more wear, but they behave more like paint when it's time to recoat.",
  },
  {
    title: 'Painting is another option',
    details:
      "If you want more solid color coverage or need to hide significant wear, painting may be worth considering. It's a different finish with different maintenance needs. We already offer deck painting as a separate service.",
  },
];

const faqs = [
  {
    question: 'How often does exterior wood need staining in Brevard?',
    answer:
      'Most projects need attention every 2–4 years. Wood in full sun or with heavy exposure usually needs it on the shorter end of that range.',
  },
  {
    question: 'Can I stain over old stain or paint?',
    answer:
      "Sometimes. If the old finish is still bonding well and not peeling or chalking, a new stain can often go over it. If it's failing, it usually needs to be removed first.",
  },
  {
    question: 'Should I use semi-transparent or solid stain?',
    answer:
      'It depends on the look you want. Semi-transparent stains keep more of the natural wood appearance and are often easier to maintain. Solid stains give more color coverage and can hide more imperfections.',
  },
  {
    question: 'How long should new wood sit before staining?',
    answer:
      'Usually several weeks to a couple of months, depending on the weather. Staining too soon prevents proper penetration.',
  },
  {
    question: 'When should wood be replaced instead of restained?',
    answer:
      "If the wood is soft, rotting, or badly warped, staining won't fix the underlying problem. Replacement is usually the better long-term option in those cases.",
  },
  {
    question: 'Do you offer deck staining?',
    answer:
      'Yes. Decks can be stained and are included under exterior wood staining. We also offer deck painting as a separate service if you prefer solid color.',
    footerLinks: [{ label: 'Deck painting', href: '/services/deck-painting-brevard-county' }],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout {title} {description}>
  <main class="page-container py-12 sm:py-16">
    <article class="mx-auto max-w-5xl space-y-12 text-base leading-relaxed text-charcoal sm:text-lg">
      <header class="space-y-5">
        <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Exterior Wood Staining
        </h1>
        <p>
          Wood decks, fences, pergolas, railings, and shutters in Brevard County face constant sun, humidity, rain, and
          mildew. Penetrating stains are a popular choice because they soak into the wood instead of sitting on top like
          paint. This helps them handle Florida's climate with less peeling as the wood expands and contracts.
        </p>
      </header>

      <div class="watercolor-divider" aria-hidden="true"></div>

      <section aria-labelledby="what-we-cover-heading" class="space-y-5">
        <h2 id="what-we-cover-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What We Cover
        </h2>
        <ul class="space-y-2">
          {whatWeCover.map((item) => (
            <li class="flex items-start gap-3 text-sm sm:text-base">
              <span class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-purple" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="approach-heading" class="space-y-5">
        <h2 id="approach-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          How We Approach It
        </h2>
        <ol class="space-y-3">
          {approachSteps.map((step) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-4 sm:p-5">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{step.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{step.details}</p>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="expect-heading" class="space-y-5">
        <h2 id="expect-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What to Expect
        </h2>
        <p>
          Most exterior wood staining jobs take 1–3 days depending on the size and condition of the project.
        </p>
        <p>
          You can usually use the area within 24–48 hours, though full curing takes longer.
        </p>
        <p>
          In Brevard conditions, exterior wood stains typically need redoing every 2–4 years. Recoating before the
          stain fully wears away is usually easier and helps protect the wood.
        </p>
      </section>

      <section aria-labelledby="tips-heading" class="space-y-5">
        <h2 id="tips-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          Homeowner Tips
        </h2>
        <ul class="space-y-4">
          {homeownerTips.map((tip) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-5 sm:p-6">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{tip.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{tip.details}</p>
            </li>
          ))}
        </ul>
      </section>

      <FaqSection items={faqs} heading="Common Questions" />
    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
