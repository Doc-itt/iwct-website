---
// Services hub page: outlines IWCT service categories and included services for Brevard County homeowners.
import FaqSection from '../../components/FaqSection.astro';
import Layout from '../../layouts/Layout.astro';

const siteUrl = 'https://iwctpainting.com';

const title = 'Painting Services in Brevard County | If Walls Could Talk';
const description =
  'Painting services in Brevard County: exterior and interior painting, cabinet and wood finishes, and concrete coatings for pool decks, patios, and garage floors. Built for Florida heat, humidity, and storms.';

const phone = '(321) 557-6959';
const phoneHref = 'tel:+13215576959';

const categories = [
  {
    id: 'exterior-painting',
    title: 'Exterior Painting',
    intro:
      'Exterior painting in Brevard takes more than just paint. We fix the surface right and use coatings built for our heat, humidity, and storms.',
    services: [
      {
        label: 'Exterior painting',
        href: '/services/exterior-painting-brevard-county',
      },
      {
        label: 'Siding painting',
        href: '/services/siding-painting-brevard-county',
      },
      {
        label: 'Stucco painting and sealing',
        href: '/services/stucco-painting-and-sealing-brevard-county',
      },
      {
        label: 'Pressure washing',
        href: '/services/pressure-washing-brevard-county',
      },
      {
        label: 'Trim, soffit, and door painting',
        href: '/services/trim-soffit-and-door-painting-brevard-county',
      },
      {
        label: 'Caulking and sealing',
        href: '/services/caulking-and-sealing-brevard-county',
      },
      {
        label: 'Stucco crack repair',
        href: '/services/stucco-crack-repair-brevard-county',
      },
    ],
  },
  {
    id: 'interior-painting',
    title: 'Interior Painting',
    intro:
      'Interior painting that holds up here starts with proper prep and finishes that actually handle Florida humidity.',
    services: [
      {
        label: 'Interior painting',
        href: '/services/interior-painting-brevard-county',
      },
      {
        label: 'Drywall painting',
        href: '/services/drywall-painting-brevard-county',
      },
      {
        label: 'Trim and baseboard painting',
        href: '/services/trim-and-baseboard-painting-brevard-county',
      },
      {
        label: 'Accent wall painting',
        href: '/services/accent-wall-painting-brevard-county',
      },
      {
        label: 'Popcorn ceiling removal',
        href: '/services/popcorn-ceiling-removal-brevard-county',
      },
      {
        label: 'Garage painting',
        href: '/services/garage-painting-brevard-county',
      },
    ],
  },
  {
    id: 'specialty-finishes-woodwork',
    title: 'Specialty Finishes & Woodwork',
    intro:
      'We update cabinets, decks, porches, and wood surfaces with finishes that stand up to daily use and moisture.',
    services: [
      {
        label: 'Cabinet painting',
        href: '/services/cabinet-painting-brevard-county',
      },
      {
        label: 'Wood painting',
        href: '/services/exterior-wood-painting-brevard-county',
      },
      {
        label: 'Wood staining',
        href: '/services/exterior-wood-staining-brevard-county',
      },
      {
        label: 'Deck painting',
        href: '/services/deck-painting-brevard-county',
      },
      {
        label: 'Porch painting',
        href: '/services/porch-painting-brevard-county',
      },
      {
        label: 'Color consultation',
        href: '/services/color-consultation-brevard-county',
      },
    ],
  },
  {
    id: 'outdoor-living-concrete-coatings',
    title: 'Outdoor Living & Concrete Coatings',
    intro:
      'Pool decks, patios, and garage floors need coatings made for sun, chlorine, rain, and heavy traffic.',
    services: [
      {
        label: 'Pool deck painting',
        href: '/services/pool-deck-painting-slip-resistant-coatings-brevard-county',
      },
      {
        label: 'Slip-resistant pool deck coating',
        href: '/services/pool-deck-painting-slip-resistant-coatings-brevard-county',
      },
      {
        label: 'Patio painting',
        href: '/services/patio-painting-brevard-county',
      },
      {
        label: 'Concrete floor coating',
        href: '/services/concrete-coatings-brevard-county',
      },
      {
        label: 'Garage floor coating',
        href: '/services/garage-floor-coating-brevard-county',
      },
      {
        label: 'Driveway sealing and painting',
        href: '/services/driveway-sealing-and-painting-brevard-county',
      },
    ],
  },
];

const faqs = [
  {
    question: 'What painting services do you offer in Brevard County?',
    answer:
      'We offer exterior painting, interior painting, cabinet and woodwork refinishing, and concrete coatings. Every job uses the same standards for preparation and materials.',
  },
  {
    question: 'Do you handle smaller painting projects in Brevard County?',
    answer:
      'Yes. Single rooms, cabinets, pool decks, fences, trim work, and touch-ups are all common and get full attention.',
  },
  {
    question: 'How long does exterior paint last in Brevard County?',
    answer:
      'With good prep it usually lasts 7–10 years. Without proper prep it often fails in 3–5 years.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]+>/g, ''),
    },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${siteUrl}/services/#service`,
  name: 'Residential Painting Services in Brevard County',
  description:
    'Exterior painting, interior painting, specialty finishes and woodwork, and outdoor living concrete coating services for homeowners in Brevard County, Florida.',
  serviceType: 'Residential painting services',
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Brevard County, Florida',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Painting Services',
    itemListElement: categories.map((category) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: category.title,
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: `${category.title} Services`,
          itemListElement: category.services.map((service) => ({
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: typeof service === 'string' ? service : service.label,
            },
          })),
        },
      },
    })),
  },
};
---

<Layout {title} {description}>
  <main class="page-container py-12 sm:py-16">
    <article class="mx-auto max-w-5xl space-y-12 text-base leading-relaxed text-charcoal sm:text-lg">
      <header class="space-y-5">
        <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Painting Services in Brevard County
        </h1>
        <p>
          We offer exterior painting, interior painting, cabinet and woodwork finishes, and concrete coatings specifically
          for Brevard County. Good preparation and the right materials make the difference between a job that lasts 7–10
          years and one that fails in 3–5.
        </p>
        <p>
          Florida’s heat, humidity, salt air, and sun are tough on paint.
        </p>
        <p>
          For more help deciding on the right approach, check our{' '}
          <a href="/homeowner-guide" class="font-medium text-purple transition-colors hover:text-coral">
            Homeowner Guide
          </a>.
          It covers what to look for when hiring a painter, questions to ask, paint products that hold up in Florida,
          and what to expect during a project.
        </p>
        <div class="flex justify-center pt-2 sm:pt-4">
          <a href="/contact" class="btn-primary text-center">Describe your project</a>
        </div>
      </header>

      <div class="watercolor-divider" aria-hidden="true"></div>

      <section aria-labelledby="service-categories-heading" class="space-y-6">
        <h2 id="service-categories-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          Service Categories
        </h2>
        <ul class="grid gap-5 md:grid-cols-2">
          {categories.map((category) => (
            <li id={category.id} class="scroll-mt-24 rounded-xl border border-charcoal/10 bg-white/60 p-5 sm:p-6">
              <h3 class="font-display text-xl font-semibold text-charcoal sm:text-2xl">{category.title}</h3>
              <p class="mt-3 text-sm text-muted sm:text-base">{category.intro}</p>
              <h4 class="mt-5 text-base font-semibold text-charcoal sm:text-lg">Included services:</h4>
              <ul class="mt-3 space-y-2">
                {category.services.map((service) => (
                  <li class="flex items-start gap-3 text-sm sm:text-base">
                    <span class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-purple" aria-hidden="true"></span>
                    {typeof service === 'string' ? (
                      <span>{service}</span>
                    ) : (
                      <a href={service.href} class="font-medium text-purple transition-colors hover:text-coral">
                        {service.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>

      <FaqSection items={faqs} headingId="services-faq-heading" />

      <p class="border-t border-charcoal/10 pt-8 text-muted">
        Not sure where your project fits? <a href="/contact" class="font-medium text-purple transition-colors hover:text-coral">Contact page</a>, or call/text{' '}
        <a href={phoneHref} class="font-medium text-purple transition-colors hover:text-coral">321-557-6959</a>.
      
      </p>
    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
