---
// Interior painting service page for Brevard County homeowners with process, tips, and FAQ.
import FaqSection from '../../components/FaqSection.astro';
import Layout from '../../layouts/Layout.astro';
import { breadcrumbSchema } from '../../data/schema';

const title = 'Interior Painting in Brevard County, FL | If Walls Could Talk';
const description =
  'Professional interior house painting in Brevard County using humidity-resistant finishes, proper preparation, and quality materials for beautiful, lasting results.';

const whatWeCover = [
  'Walls and ceilings',
  'Trim, baseboards, and door casings',
  'Interior doors',
  'Drywall repair',
  'Accent walls',
  'Popcorn ceiling removal',
  'Mildew-resistant coatings for bathrooms, kitchens, and laundry rooms',
];

const approachSteps = [
  {
    title: 'Protect the space',
    details:
      'Move and cover furniture, then mask floors, window frames, and fixtures staying in place.',
  },
  {
    title: 'Clean the surfaces',
    details:
      'Degrease kitchen walls and treat mildew before paint goes on.',
  },
  {
    title: 'Repair the drywall',
    details:
      'Fill nail holes, cracks, and dings, then sand smooth before the finish coat goes on.',
  },
  {
    title: 'Prime where needed',
    details:
      'Use the right primer for fresh drywall, water stains, repaired areas, and major color transitions from dark to light.',
  },
  {
    title: 'Paint',
    details:
      'Apply the right number of coats for the color and surface. Most walls need two coats; dark-to-light transitions may need three.',
  },
];

const homeownerTips = [
  {
    title: 'Sheen matters more in Florida than most places',
    details:
      "Flat paint isn't a practical option in bathrooms or kitchens. Moisture gets behind it and mildew follows. Eggshell is the minimum for those rooms; satin gives you more durability and makes cleaning easier. In living areas and bedrooms, flat or matte is fine. It is mostly about goals and preferences.",
  },
  {
    title: "Don't paint over mildew",
    details:
      "Treat mildew first with a diluted bleach solution, let it dry fully, then use a stain-blocking primer before painting. Painting over it doesn't fix it — it just delays the problem.",
  },
  {
    title: 'Wait before washing new paint',
    details:
      "Fresh paint feels dry within an hour or two but often needs 2–4 weeks to fully cure. Washing too soon — especially in Florida's humidity — can damage the finish before it's set.",
  },
  {
    title: 'Ventilate during and after',
    details:
      "Run fans and AC during painting and for at least 24 hours after. It speeds curing and clears fumes. In Florida's humidity, ventilation makes a real difference in how the finish sets.",
  },
];

const faqs = [
  {
    question: 'How long does interior paint last in Florida?',
    answer:
      'In living areas and bedrooms, 7–10 years is reasonable with good prep and quality paint. Bathrooms and kitchens are harder — humidity and moisture stress the coating more, and 3–5 years is a more realistic expectation there.',
  },
  {
    question: 'What paint sheen should I use in a Florida home?',
    answer:
      "In bathrooms and kitchens, eggshell is the minimum — flat paint doesn't hold up to moisture. Satin gives you more durability and is easier to clean. In living areas and bedrooms, flat or matte works fine if the walls are in decent shape; eggshell if you want something more washable.",
  },
  {
    question: 'Do you move furniture before interior painting?',
    answer:
      'Yes. Standard furniture is moved and covered as part of prep. Very large or heavy pieces may stay in place and be fully protected while we work around them.',
  },
  {
    question: 'How long does interior paint take to cure in Florida humidity?',
    answer:
      'Most latex paints are dry to the touch within 1–2 hours but need 2–4 weeks to fully cure. High humidity slows curing, so keeping the AC running and fans going helps significantly.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
const breadcrumbs = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'Interior Painting' },
]);

const relatedLinks = [
  { label: 'Trim and Baseboard Painting', href: '/services/trim-and-baseboard-painting-brevard-county' },
  { label: 'Accent Wall Painting', href: '/services/accent-wall-painting-brevard-county' },
  { label: 'Cabinet Painting', href: '/services/cabinet-painting-brevard-county' },
  { label: 'Blog: How Paint Colors Affect How You Feel at Home', href: '/blog/how-paint-colors-affect-how-you-feel' },
];

---

<Layout {title} {description}>
  <main class="page-container py-12 sm:py-16">
    <article class="mx-auto max-w-5xl space-y-12 text-base leading-relaxed text-charcoal sm:text-lg">
      <header class="space-y-5">
        <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Interior Painting
        </h1>
        <p>
          Interior painting in Brevard County needs more attention to mildew, humidity control, and product choice than most
          people realize.
        </p>
        <p>
          Get the prep and products right and paint in living areas can last 7–10 years. Get it wrong — wrong sheen,
          skipped prep, or painting over existing mildew — and you might be repainting a bathroom in three years.
        </p>
      </header>

      <div class="watercolor-divider" aria-hidden="true"></div>

      <section aria-labelledby="what-we-cover-heading" class="space-y-5">
        <h2 id="what-we-cover-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What We Cover
        </h2>
        <p>A complete project can include:</p>
        <ul class="space-y-2">
          {whatWeCover.map((item) => (
            <li class="flex items-start gap-3 text-sm sm:text-base">
              <span class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-purple" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="text-muted">We can handle one room or the whole house, whatever the project needs.</p>
      </section>

      <section aria-labelledby="approach-heading" class="space-y-5">
        <h2 id="approach-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          How We Approach It
        </h2>
        <p>Every interior job follows the same sequence, regardless of room count or project size:</p>
        <ol class="space-y-3">
          {approachSteps.map((step) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-4 sm:p-5">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{step.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{step.details}</p>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="expect-heading" class="space-y-5">
        <h2 id="expect-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What to Expect
        </h2>
        <p>
          Interior painting timelines depend heavily on how much prep is needed and drying conditions. A single room
          with light prep usually takes 1 day. Heavy prep (patching, sanding, mildew treatment, moving furniture) can
          stretch that to 1.5–2 days. Whole-house jobs typically take 3–7 days depending on the number of rooms, ceiling
          height, and condition of the walls.
        </p>
        <p>We always give you a clear timeline after we see the space.</p>
        <p>
          We document every product used (brand, color code, and sheen) so future touch-ups are simple.
        </p>
      </section>

      <section aria-labelledby="tips-heading" class="space-y-5">
        <h2 id="tips-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          Homeowner Tips
        </h2>
        <ul class="space-y-4">
          {homeownerTips.map((tip) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-5 sm:p-6">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{tip.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{tip.details}</p>
            </li>
          ))}
        </ul>
      </section>

      <FaqSection items={faqs} />

      <nav class="space-y-4 border-t border-charcoal/10 pt-10" aria-labelledby="related-links-heading">
        <h2 id="related-links-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          Related Services &amp; Reading
        </h2>
        <ul class="space-y-3">
          {relatedLinks.map((item) => (
            <li>
              <a href={item.href} class="font-medium text-purple transition-colors hover:text-coral">
                {item.label} →
              </a>
            </li>
          ))}
        </ul>
      </nav>

    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}></script>
</Layout>
