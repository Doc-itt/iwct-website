---
// Pool deck and concrete coating service page for Brevard County homeowners with process, options, tips, and FAQ.
import FaqSection from '../../components/FaqSection.astro';
import Layout from '../../layouts/Layout.astro';

const title = 'Pool Deck Painting & Slip-Resistant Coatings | If Walls Could Talk';
const description =
  'Slip-resistant pool deck coatings and painting in Brevard County. Professional crack repair and textured finishes for safer, better-looking outdoor spaces.';

const whatWeCover = [
  'Pool decks and pool surrounds',
  'Slip-resistant textured coatings',
  'Patios and screened enclosure floors',
  'Concrete crack repair before coating',
  'Polyaspartic coatings',
  'Garage and utility concrete floors',
];

const coatingOptions = [
  {
    title: 'Acrylic pool deck coating',
    details:
      'The most common option. Decent color retention and UV resistance. Usually needs recoating every 3–5 years in Florida sun. Lower upfront cost.',
  },
  {
    title: 'Slip-resistant textured coating',
    details:
      'Acrylic base with added grit for grip. The texture stays effective even when the surface is wet.',
  },
  {
    title: 'Polyaspartic coating',
    details:
      "Cures fast and resists UV and pool chemicals better than standard acrylic. It generally lasts longer, but it's still relatively new on pool decks, so long-term real-world data isn't fully available yet. Higher upfront cost.",
  },
];

const approachSteps = [
  {
    title: 'Pressure wash thoroughly',
    details:
      'Remove dirt, algae, chlorine residue, and anything loose or flaking.',
  },
  {
    title: 'Inspect and repair',
    details:
      'Fill cracks and spalled areas. Coating over existing problems shortens the life of anything put on top.',
  },
  {
    title: 'Let the concrete dry completely',
    details:
      'Florida humidity makes this step critical. The surface must be fully dry before coating.',
  },
  {
    title: 'Apply the coating',
    details:
      'Use the right product at the proper thickness, with slip-resistant texture added where needed.',
  },
];

const homeownerTips = [
  {
    title: "Don't coat over failing surfaces",
    details:
      'Everything loose or peeling has to be removed first. Coating over it just traps the problem underneath.',
  },
  {
    title: 'Lighter colors stay cooler',
    details:
      'Dark colors get much hotter under bare feet on Florida days.',
  },
  {
    title: 'Fix cracks before coating',
    details:
      'Pool water and chlorine will make existing cracks worse over time.',
  },
  {
    title: 'Balance grip and comfort',
    details:
      'More texture improves slip resistance but can feel rougher on bare feet. It depends on who uses the deck most.',
  },
  {
    title: 'Plan for maintenance',
    details:
      'Acrylic coatings on pool decks usually need recoating every 3–5 years here. Good prep and regular cleaning help them last longer.',
  },
];

const faqs = [
  {
    question: 'What makes a pool deck coating slip-resistant?',
    answer:
      "Texture material (silica sand or polymer grit) is mixed in or broadcast while the coating is wet. This keeps the surface safer when it's wet from the pool or rain.",
  },
  {
    question: 'How often does pool deck coating need recoating in Florida?',
    answer:
      "Acrylic usually needs recoating every 3–5 years. Polyaspartic is said to last longer, but it's still a relatively new product on pool decks, so long-term real-world data isn't fully available yet. Good prep and maintenance make the biggest difference with either one.",
  },
  {
    question: 'Is polyaspartic worth the extra cost?',
    answer:
      'It costs more upfront. The main advantages are faster cure time and better resistance to sun and chemicals. On decks that get heavy use, the longer lifespan often makes sense. On lighter-use decks where budget is tighter, standard acrylic is usually the more practical choice.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout {title} {description}>
  <main class="page-container py-12 sm:py-16">
    <article class="mx-auto max-w-5xl space-y-12 text-base leading-relaxed text-charcoal sm:text-lg">
      <header class="space-y-5">
        <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Pool Deck Painting & Slip-Resistant Coatings
        </h1>
        <p>
          Pool deck coatings in Brevard County have to protect the concrete from sun, chlorine, and rain while staying safe to
          walk on when wet. How long any coating lasts depends mostly on how well the surface was prepped, materials
          used, and how well it's maintained.
        </p>
      </header>

      <div class="watercolor-divider" aria-hidden="true"></div>

      <section aria-labelledby="what-we-cover-heading" class="space-y-5">
        <h2 id="what-we-cover-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          What We Cover
        </h2>
        <ul class="space-y-2">
          {whatWeCover.map((item) => (
            <li class="flex items-start gap-3 text-sm sm:text-base">
              <span class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-purple" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="coating-options-heading" class="space-y-5">
        <h2 id="coating-options-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          Coating Options
        </h2>
        <ul class="space-y-4">
          {coatingOptions.map((option) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-5 sm:p-6">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{option.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{option.details}</p>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="approach-heading" class="space-y-5">
        <h2 id="approach-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          How We Approach It
        </h2>
        <p>
          Pool decks take the hardest beating in Florida — constant sun, rain, chemicals, and foot traffic. We build the
          process around those realities.
        </p>
        <ol class="space-y-3">
          {approachSteps.map((step) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-4 sm:p-5">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{step.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{step.details}</p>
            </li>
          ))}
        </ol>
        <p>
          When we're done, we'll walk you through exactly what was done and give you a simple maintenance schedule.
        </p>
        <p class="text-muted">
          Most jobs finish in 1–2 days. Polyaspartic is usually ready for light foot traffic the same day, with full
          cure in 24–72 hours. Standard acrylic typically needs 24–48 hours before light use and several weeks for a
          full cure.
        </p>
      </section>

      <section aria-labelledby="tips-heading" class="space-y-5">
        <h2 id="tips-heading" class="font-display text-2xl font-semibold sm:text-3xl">
          Homeowner Tips
        </h2>
        <ul class="space-y-4">
          {homeownerTips.map((tip) => (
            <li class="rounded-xl border border-charcoal/10 bg-white/60 p-5 sm:p-6">
              <h3 class="font-display text-lg font-semibold sm:text-xl">{tip.title}</h3>
              <p class="mt-2 text-sm text-muted sm:text-base">{tip.details}</p>
            </li>
          ))}
        </ul>
      </section>

      <FaqSection items={faqs} />
    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
